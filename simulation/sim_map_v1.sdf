<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="map_world">
    
    <!-- Scene & Lighting Settings -->
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <!-- Core & Sensor Plugins -->
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Walls 10x10m -->
    <model name="outer_walls">
      <static>true</static>
      <link name="wall_link">
        <visual name="wall_n">
          <pose>0 5 1 0 0 0</pose>
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
        <collision name="col_n">
          <pose>0 5 1 0 0 0</pose>
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>

        <visual name="wall_s">
          <pose>0 -5 1 0 0 0</pose>
          <geometry><box><size>10 0.2 2</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
        <collision name="col_s">
          <pose>0 -5 1 0 0 0</pose>
          <geometry><box><size>10 0.2 2</size></box></geometry>
        </collision>

        <visual name="wall_e">
          <pose>5 0 1 0 0 0</pose>
          <geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
        <collision name="col_e">
          <pose>5 0 1 0 0 0</pose>
          <geometry><box><size>0.2 10 2</size></box></geometry>
        </collision>

        <visual name="wall_w">
          <pose>-5 0 1 0 0 0</pose>
          <geometry><box><size>0.2 10 2</size></box></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.9 0.4 0.1 1</diffuse></material>
        </visual>
        <collision name="col_w">
          <pose>-5 0 1 0 0 0</pose>
          <geometry><box><size>0.2 10 2</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Obstacles -->
    <model name="obstacles">
      <static>true</static>
      <link name="obs_link">
        <visual name="box1">
          <pose>2 2 0.5 0 0 0</pose>
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
        <collision name="c_box1">
          <pose>2 2 0.5 0 0 0</pose>
          <geometry><box><size>1.5 1.5 1</size></box></geometry>
        </collision>

        <visual name="pillar1">
          <pose>-2 2 1 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
        <collision name="c_pil1">
          <pose>-2 2 1 0 0 0</pose>
          <geometry><cylinder><radius>0.4</radius><length>2</length></cylinder></geometry>
        </collision>

        <visual name="pillar2">
          <pose>2 -2 1 0 0 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
        <collision name="c_pil2">
          <pose>2 -2 1 0 0 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>2</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Robot Model -->
    <model name="robot">
      <pose>0 0 0.08 0 0 0</pose>

      <link name="chassis">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.05</iyy><iyz>0</iyz>
            <izz>0.05</izz>
          </inertia>
        </inertial>
        <visual name="v_body">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
        <collision name="c_body">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
        </collision>

        <!-- Caster Wheel -->
        <visual name="v_caster">
          <pose>0.15 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient></material>
        </visual>
        <collision name="c_caster">
          <pose>0.15 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.03</radius></sphere></geometry>
          <surface>
            <friction>
              <ode><mu>0.001</mu><mu2>0.001</mu2></ode>
            </friction>
          </surface>
        </collision>

        <!-- 2D LiDAR Sensor -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.1 0 0.12 0 0 0</pose>
          <topic>scan</topic>
          <ign:frame_id>laser</ign:frame_id>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
            </range>
          </ray>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Left Wheel -->
      <link name="left_wheel">
        <pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="v_lw">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c_lw">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>100.0</mu><mu2>100.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>

      <!-- Right Wheel -->
      <link name="right_wheel">
        <pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.001</iyy><iyz>0</iyz>
            <izz>0.001</izz>
          </inertia>
        </inertial>
        <visual name="v_rw">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
        <collision name="c_rw">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>100.0</mu><mu2>100.0</mu2></ode>
            </friction>
          </surface>
        </collision>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent>
        <child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <!-- Diff Drive Plugin -->
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/model/robot/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
      </plugin>

    </model>

  </world>
</sdf>
