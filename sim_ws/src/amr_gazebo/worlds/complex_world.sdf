    <!-- ================================================================
         Dynamic obstacle: "pedestrian"
         A simple person-sized cylinder that a ROS 2 node drives back and
         forth along the main east-west corridor (y ~ 0) using the
         VelocityControl system. Unlike a scripted <actor>, this model has
         real collision geometry, so it shows up in the LIDAR /scan and in
         the Nav2 costmap like a genuine moving obstacle - useful for
         testing dynamic obstacle avoidance (DWB / regulated pure pursuit,
         costmap inflation, etc).
         Gravity is disabled on the link so the cylinder glides at a fixed
         height instead of tipping over; only linear.x is ever commanded
         (yaw stays 0), so body-frame x == world-frame x at all times.
         Drive it with:
           ros2 topic pub /pedestrian/cmd_vel geometry_msgs/msg/Twist \
             "{linear: {x: 0.5}}"
         or use amr_gazebo/scripts/pedestrian_walker.py to make it patrol
         automatically (see amr_gazebo/launch/pedestrian.launch.py).
         ================================================================ -->
    <model name="pedestrian">
      <pose>-4.0 0.0 0.9 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>70.0</mass>
          <inertia>
            <ixx>20.0</ixx><iyy>20.0</iyy><izz>2.0</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.22</radius><length>1.70</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual_body">
          <geometry>
            <cylinder><radius>0.22</radius><length>1.70</length></cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.35 0.15 1</ambient>
            <diffuse>0.85 0.35 0.15 1</diffuse>
          </material>
        </visual>
        <visual name="visual_head">
          <pose>0 0 1.02 0 0 0</pose>
          <geometry>
            <sphere><radius>0.14</radius></sphere>
          </geometry>
          <material>
            <ambient>0.90 0.75 0.60 1</ambient>
            <diffuse>0.90 0.75 0.60 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
        <topic>/model/pedestrian/cmd_vel</topic>
      </plugin>
    </model>
  </world>
</sdf>

