<?xml version="1.0"?>
<robot name="amr" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!--  AMR PHYSICAL PARAMETERS (from user spec)                     -->
  <!--  wheel_diameter  = 128 mm                                     -->
  <!--  wheel_distance   = 472 mm  (track / separation)               -->
  <!--  base width (Y)  = 496 mm                                     -->
  <!--  base depth (X)  = 951 mm                                     -->
  <!--  base height (Z) = 301 mm                                     -->
  <!-- ============================================================ -->
  <xacro:property name="wheel_diameter"   value="0.128"/>
  <xacro:property name="wheel_radius"     value="${wheel_diameter/2}"/>
  <xacro:property name="wheel_width"      value="0.06"/>
  <xacro:property name="wheel_separation" value="0.472"/>

  <xacro:property name="base_width"   value="0.496"/> <!-- Y -->
  <xacro:property name="base_depth"   value="0.951"/> <!-- X -->
  <xacro:property name="base_height"  value="0.301"/> <!-- Z -->
  <xacro:property name="base_mass"    value="45.0"/>

  <xacro:property name="wheel_mass"   value="1.5"/>
  <xacro:property name="caster_radius" value="0.04"/>
  <xacro:property name="caster_mass"  value="0.3"/>

  <!-- how high above the wheel-axis the base box sits -->
  <xacro:property name="base_z_offset" value="${wheel_radius}"/>

  <!-- lidar -->
  <xacro:property name="lidar_radius" value="0.038"/>
  <xacro:property name="lidar_height" value="0.05"/>
  <xacro:property name="lidar_x" value="${base_depth/2 - 0.08}"/>
  <xacro:property name="lidar_z" value="${base_height + lidar_height/2 + 0.01}"/>

  <!-- depth camera (RealSense D435-style RGBD module)
       Mounted directly above the lidar with generous vertical clearance
       (3cm gap above the lidar's top face) so its housing/FOV cannot
       physically occlude the 2D lidar's 360-degree scan plane. -->
  <xacro:property name="cam_size_x" value="0.025"/>
  <xacro:property name="cam_size_y" value="0.09"/>
  <xacro:property name="cam_size_z" value="0.025"/>
  <xacro:property name="cam_x" value="${lidar_x + 0.10}"/>
  <xacro:property name="cam_z" value="${lidar_z - 0.08}"/>

  <material name="body_red">
    <color rgba="0.85 0.05 0.05 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="caster_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>
  <material name="lidar_orange">
    <color rgba="0.9 0.45 0.05 1.0"/>
  </material>
  <material name="cam_dark">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ============================ inertia helper macros ============================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0.0" ixz="0.0"
              iyy="${m*(x*x+z*z)/12}" iyz="0.0"
              izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0.0" ixz="0.0"
              iyy="${m*(3*r*r+h*h)/12}" iyz="0.0"
              izz="${m*r*r/2}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="m r">
    <inertia ixx="${2*m*r*r/5}" ixy="0.0" ixz="0.0"
              iyy="${2*m*r*r/5}" iyz="0.0"
              izz="${2*m*r*r/5}"/>
  </xacro:macro>

  <!-- ============================ base_footprint / base_link ============================ -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z_offset}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_depth} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_depth} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <xacro:box_inertia m="${base_mass}" x="${base_depth}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- ============================ drive wheels (differential) ============================ -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!-- wheels mounted at the drive axis (base_link origin height), centred in X,
           offset sideways by half the wheel separation -->
      <origin xyz="0 ${reflect*wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ============================ passive caster wheels (front & rear, for stability) ============================ -->
  <xacro:macro name="caster_wheel" params="prefix x">
    <link name="${prefix}_caster_link">
      <visual>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
        <material name="caster_grey"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="${caster_radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${caster_mass}"/>
        <xacro:sphere_inertia m="${caster_mass}" r="${caster_radius}"/>
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_link"/>
      <origin xyz="${x} 0 ${-(wheel_radius-caster_radius)}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="front" x="${base_depth/2 - 0.12}"/>
  <xacro:caster_wheel prefix="rear"  x="${-(base_depth/2 - 0.12)}"/>

  <!-- ============================ 2D LiDAR ============================ -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="lidar_orange"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.25"/>
      <xacro:cylinder_inertia m="0.25" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- mounted near the front, on top of the chassis -->
    <origin xyz="${lidar_x} 0 ${lidar_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================ IMU (for odom drift correction via EKF) ============================ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <!-- mounted at the robot's center of rotation, near the drive-wheel axis -->
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============================ Depth camera (RGBD) ============================ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${cam_size_x} ${cam_size_y} ${cam_size_z}"/>
      </geometry>
      <material name="cam_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cam_size_x} ${cam_size_y} ${cam_size_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:box_inertia m="0.1" x="${cam_size_x}" y="${cam_size_y}" z="${cam_size_z}"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- front-facing, mounted below the lidar and slightly forward -->
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 0 0"/>
  </joint>

  <!-- Optical frame retained for ROS camera integrations that explicitly
       need REP-103/REP-105 conversion. The Gazebo RGBD point cloud in this
       Fortress-compatible configuration is intentionally published in
       camera_link, because older gz-sensors versions can generate the
       PointCloudPacked coordinates in the rendering camera frame even when
       optical_frame_id is set. -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ============================ ros2_control-free: Ignition plugins ============================ -->
  <xacro:include filename="$(find amr_description)/urdf/amr.gazebo.xacro"/>

</robot>
