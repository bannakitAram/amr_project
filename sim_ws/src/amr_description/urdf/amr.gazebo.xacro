<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!--  Gazebo (Ignition / gz-sim) material tags                    -->
  <!-- ============================================================ -->
  <gazebo reference="base_link">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="front_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="rear_caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="lidar_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <!-- ============================================================ -->
  <!--  Differential drive plugin (Ignition Gazebo Fortress)        -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.472</wheel_separation>
      <wheel_radius>0.064</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odometry</odom_topic>
      <!-- tf_topic intentionally omitted: robot_localization's EKF now owns the
           odom -> base_footprint transform (fused wheel+IMU, drift-corrected).
           Publishing it here too would create two competing TF broadcasters. -->
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
      <max_linear_velocity>1.2</max_linear_velocity>
      <min_linear_velocity>-1.2</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>

    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

  </gazebo>

  <!-- ============================================================ -->
  <!--  IMU sensor - fused with wheel odom via robot_localization    -->
  <!--  to correct wheel-odometry drift (esp. heading/yaw)           -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
  </gazebo>

  <!-- ============================================================ -->
  <!--  2D LiDAR sensor (gpu_lidar) - e.g. RPLidar A2 / SICK-class   -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_2d" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <update_rate>15</update_rate>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>16.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!--  Depth camera (RGBD) - e.g. Intel RealSense D435-class        -->
  <!--  Sensor is physically attached to camera_link (forward-facing, -->
  <!--  same orientation as base_link/lidar) so it actually looks     -->
  <!--  where the robot is heading. camera_optical_link is ONLY used  -->
  <!--  as the published frame_id (via optical_frame_id below) so     -->
  <!--  downstream image/pointcloud data follows REP-105 optical      -->
  <!--  axis convention (z-forward, x-right, y-down) - it does NOT    -->
  <!--  change which way the camera physically points.                -->
  <!-- ============================================================ -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <topic>camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <!--
        IMPORTANT (Gazebo Fortress / older gz-sensors):
        Keep the RGBD point-cloud message in camera_link.
        The rendering camera uses +X as forward, while the ROS optical
        frame uses +Z as forward. On older Fortress sensor versions the
        RGBD PointCloud can be generated in the rendering camera frame
        even when optical_frame_id is set, which makes RViz show the
        cloud rotated relative to the RGB image.
        camera_link is therefore used as the point-cloud frame here.
        The physical camera orientation remains unchanged (forward).
      -->
      <ignition_frame_id>camera_link</ignition_frame_id>
      <camera>
        <optical_frame_id>camera_link</optical_frame_id>
        <horizontal_fov>1.0472</horizontal_fov> <!-- ~60 deg, RealSense-class -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- NOTE: the Sensors system plugin (with render_engine ogre2) that drives
       camera rendering is already loaded once at world level in
       complex_world.sdf - it is NOT redeclared here, since duplicating it
       per-model can conflict over the shared rendering context. Unlike the
       IMU/lidar systems (pure math, safe to duplicate), Sensors owns the
       render engine, so only one instance should exist per world. -->

</robot>
