<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_bringup</name>
  <version>1.0.0</version>
  <description>Top-level bring-up: Gazebo + robot spawn + ros_gz_bridge + slam_toolbox + RViz2, all in one launch file.</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>amr_description</exec_depend>
  <exec_depend>amr_gazebo</exec_depend>
  <exec_depend>amr_slam</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
